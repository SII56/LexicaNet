{
  "manifest_version": 3,
  "name": "Lexical Network Anki TSV",
  "version": "0.1",
  "permissions": ["contextMenus", "storage", "clipboardWrite"],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lexical Anki"
  }
  
}
