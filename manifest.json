{
  "manifest_version": 3,
  "name": "LexicaNet",
  "version": "0.3",
  "permissions": [
    "contextMenus",
    "storage",
    "clipboardWrite",
    "offscreen"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LexicaNet",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
